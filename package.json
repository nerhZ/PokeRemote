{
	"name": "pokemon-app",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"engines": {
		"bun": ">=1.0.0"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build && bun scripts/postbuild.mjs",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"format": "bun x prettier --write \"src/**/*.{svelte,ts,css,html}\"",
		"format:check": "bun x prettier --check \"src/**/*.{svelte,ts,css,html}\""
	},
	"devDependencies": {
		"@stylexjs/unplugin": "^0.19.0",
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/kit": "^2.70.2",
		"@sveltejs/vite-plugin-svelte": "^6.2.4",
		"knip": "^6.31.0",
		"prettier": "^3.9.6",
		"prettier-plugin-svelte": "^4.1.1",
		"svelte": "^5.56.8",
		"svelte-check": "^4.7.4",
		"typescript": "^5.9.3",
		"vite": "^7.3.6"
	},
	"dependencies": {
		"@stylexjs/stylex": "^0.19.0"
	}
}
